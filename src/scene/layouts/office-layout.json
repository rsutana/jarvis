{
  "$schema": "Jarvis office layout v1 — mirrors OfficeScene.dc.html exactly",
  "units": {
    "world": "1 unit = 1 floor tile = 1 metre",
    "axes": "x = along the back-right wall (design gx), z = along the back-left wall (design gy), y = up",
    "origin": "back corner where the two walls meet, on the floor",
    "position": "[x, z] is the footprint CENTRE of the object unless noted; y is 0 (floor) unless given",
    "rotationY": "degrees; 0 = model front faces +z (towards the camera side), 90 = faces +x",
    "size": "[width x, depth z, height y] in metres — scale GLBs to fit this box"
  },
  "camera": {
    "type": "OrthographicCamera",
    "isoAngles": { "yawDeg": 45, "pitchDeg": -35.264 },
    "target": [12, 0, 9],
    "zoom": { "default": 1, "min": 0.6, "max": 1.8 },
    "drawerShiftPx": "pass the drawer width; pan the target so the room stays visible left of the drawer (Workspace 360px → -150px, Orchestrator/TaskRun 980px → -380px, Tasks/Changes 1020px → -400px)"
  },
  "room": {
    "size": [24, 18],
    "floor": { "tile": 1, "colors": ["#5E6672", "#59616D"], "pattern": "checker", "slabThickness": 0.3 },
    "walls": [
      { "id": "wall-back-right", "from": [0, 0], "to": [24, 0], "height": 3.2, "thickness": 0.4, "innerColor": "#424A5E", "capColor": "#58627A", "trim": { "color": "#2FA58A", "height": 0.15 } },
      { "id": "wall-back-left", "from": [0, 0], "to": [0, 18], "height": 3.2, "thickness": 0.4, "innerColor": "#3B4357", "capColor": "#58627A", "trim": { "color": "#2FA58A", "height": 0.15 } }
    ],
    "trimColorSource": "workspace.color",
    "windows": [
      { "wall": "wall-back-right", "from": 2.5, "to": 5.1, "y": [0.95, 2.65], "model": "window_double.glb" },
      { "wall": "wall-back-right", "from": 6.0, "to": 8.6, "y": [0.95, 2.65], "model": "window_double.glb" },
      { "wall": "wall-back-right", "from": 9.5, "to": 12.1, "y": [0.95, 2.65], "model": "window_double.glb" },
      { "wall": "wall-back-right", "from": 13.0, "to": 15.6, "y": [0.95, 2.65], "model": "window_double.glb" },
      { "wall": "wall-back-left", "from": 10.0, "to": 12.4, "y": [0.95, 2.65], "model": "window_double.glb" },
      { "wall": "wall-back-left", "from": 13.4, "to": 15.8, "y": [0.95, 2.65], "model": "window_double.glb" }
    ]
  },
  "desks": [
    { "slot": 0, "agentId": "rex",   "desk": [8.2, 12.6],  "chair": [7.25, 13.75],  "stand": [8.2, 13.85],  "mug": "#F2B544", "deskPlant": false },
    { "slot": 1, "agentId": "kei",   "desk": [8.2, 3.6],   "chair": [7.25, 4.75],   "stand": [8.2, 4.85],   "mug": "#5E9BEA", "deskPlant": true },
    { "slot": 2, "agentId": "shake", "desk": [12.7, 3.6],  "chair": [11.75, 4.75],  "stand": [12.7, 4.85],  "mug": "#E5584A", "deskPlant": false },
