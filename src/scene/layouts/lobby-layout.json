{
  "$schema": "Jarvis lobby (campus) layout v1 — mirrors LobbyScene.dc.html exactly",
  "units": {
    "world": "1 unit = 1 ground tile = 1 metre (buildings are stylised, not to scale)",
    "axes": "x = design gx (towards lower-right on screen), z = design gy (towards lower-left), y = up",
    "origin": "top (back) corner of the campus slab, ground level",
    "position": "[x, z] footprint centre unless the key is 'plot' (then [x, z, w, d] from the min corner)",
    "rotationY": "degrees; 0 = front faces +z"
  },
  "camera": { "type": "OrthographicCamera", "isoAngles": { "yawDeg": 45, "pitchDeg": -35.264 }, "target": [11, 0, 14], "zoom": { "default": 0.55, "min": 0.4, "max": 1.8 } },
  "ground": { "size": [30, 20], "slabThickness": 0.6, "grass": ["#5C9A47", "#58944A"], "soil": ["#6B4E36", "#58402C"], "pattern": "checker" },
  "roads": [
    { "id": "road-x", "plot": [0, 9, 30, 2], "paving": ["#A6ACB4", "#8F959D"], "curb": "#D2D6DB" },
    { "id": "road-z", "plot": [9, 0, 2, 20], "paving": ["#A6ACB4", "#8F959D"], "curb": "#D2D6DB" }
  ],
  "plaza": { "center": [10, 10], "radius": 2.5, "color": "#B4B9C0", "ring": "#D2D6DB" },
  "jarvisPortal": { "model": "jarvis_portal.glb", "position": [10, 10], "radius": 1.4, "pedestalHeight": 0.3, "beamHeight": 2.2, "colors": { "core": "#8C9BFF", "ring": "#4FD1B5" }, "route": "/jarvis", "label": { "anchor": [10, 3.4, 10], "title": "Jarvis", "sub": "Main assistant · {state}" } },
  "workspaceSlots": [
    { "slot": 0, "plot": [13, 2, 6, 5], "label": { "anchor": [16, 2.9, 4.5] } },
    { "slot": 1, "plot": [2, 2, 5, 4],  "label": { "anchor": [4.5, 2.3, 4] } },
    { "slot": 2, "plot": [2, 13, 5, 4], "label": { "anchor": [4.5, 1.9, 15] } },
    { "slot": 3, "plot": [13, 13, 5, 4], "label": { "anchor": [15.5, 0.2, 15] } },
    { "slot": 4, "plot": [22, 2, 6, 5], "label": { "anchor": [25, 2.9, 4.5] } },
    { "slot": 5, "plot": [22, 13, 6, 5], "label": { "anchor": [25, 2.9, 15.5] } }
  ],
  "maxWorkspaces": 6,
  "buildings": [
    { "workspaceId": "ryscript",       "slot": 0, "model": "office_building_m.glb", "floors": 4, "height": 7.5, "roof": "#34B394", "lit": true,  "solar": true,  "label": "Ryscript", "sub": "{agents} agents · {working} working" },
    { "workspaceId": "news-website",   "slot": 1, "model": "office_building_s.glb", "floors": 3, "height": 6.0, "roof": "#4A7FE0", "lit": false, "solar": false, "label": "News website" },
    { "workspaceId": "alumni-website", "slot": 2, "model": "office_building_s.glb", "floors": 2, "height": 4.5, "roof": "#D7655A", "lit": false, "solar": false, "label": "Alumni website", "badge": "setup-needed" }
  ],
  "buildingRules": {
    "roofColor": "Workspace.color → tailwind workspace.* token",
    "lit": "true while ≥1 agent in the workspace has status 'working' (emissive window material on)",
    "entrance": "glass doors + awning in roof colour, centred on the +z face",
    "newSlots": "a new workspace takes the first free slot; the campus holds maxWorkspaces buildings and the lot disappears when full",
    "floors": "1 + one floor per 3 agents, up to 4"
  },
  "newWorkspaceLot": { "ground": "#C2A878", "glow": "#FFE2A0", "outline": "dashed #EEF1FF", "button": { "label": "New workspace", "route": "/workspaces/new" } },
  "props": [
    { "model": "hedge.glb", "plots": [[12, 8, 8, 0.5], [1, 8, 7.5, 0.5], [1, 18.3, 7.5, 0.5], [8.3, 12.5, 0.5, 6], [21.5, 18.6, 7, 0.4]], "height": 0.45 },
    { "model": "flower_bed.glb", "plots": [[11.7, 11.7, 1.3, 1.3], [7, 7, 1.3, 1.3], [11.7, 7, 1.3, 1.3], [20.1, 15.2, 1.2, 1.2]] },
    { "model": "tree_round.glb", "positions": [[0.9, 18.9], [19.1, 0.9], [18.9, 18.9], [6, 7.7], [18.9, 12.3], [12.5, 18.9], [0.9, 7.7], [0.9, 0.9], [8, 0.9], [16, 19.1], [20.6, 0.9], [29.1, 0.9], [29.1, 4.6], [20.6, 4.6], [29.1, 15.6], [29.3, 19.3], [20.4, 19.3]], "height": 2.2 },
    { "model": "street_lamp.glb", "positions": [[8.56, 8.56], [11.56, 8.56], [8.56, 11.56], [11.56, 11.56], [3.06, 8.56], [16.56, 11.56], [8.56, 3.06], [11.56, 16.56], [21.06, 8.56], [21.06, 11.56]], "height": 2.6, "lightColor": "#FFE7A3", "pointLight": { "intensity": 0.6, "distance": 4 } },
    { "model": "bench.glb", "positions": [[6.9, 11.85], [13.1, 11.85], [25, 19.35]], "rotationY": 0 }
  ],
  "markings": { "paint": "#F2F4F7", "crosswalks": 0.7, "turnaroundRadius": 1.15 },
  "parking": [
    { "plot": [22, 7.3, 6, 1.5], "bays": 4, "parked": [{ "bay": 1, "color": "#4A7FE0" }] },
    { "plot": [22, 11.2, 6, 1.5], "bays": 4, "parked": [{ "bay": 2, "color": "#8A6FE0" }] }
  ],
  "traffic": {
    "lanes": { "offset": 0.5, "roundaboutRadius": { "x": 2.05, "z": 1.6 } },
    "cars": [
      { "track": "x", "offset": 0.0,  "speed": 2.4, "color": "#E5584A" },
      { "track": "x", "offset": 0.26, "speed": 2.4, "color": "#EDEFF2" },
      { "track": "x", "offset": 0.5,  "speed": 2.4, "color": "#34B394" },
      { "track": "x", "offset": 0.76, "speed": 2.4, "color": "#2B3646" },
      { "track": "z", "offset": 0.1,  "speed": 2.0, "color": "#F2B544" },
      { "track": "z", "offset": 0.6,  "speed": 2.0, "color": "#4FA3E0" }
    ]
  }
}
