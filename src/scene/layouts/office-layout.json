      { "pos": [21.25, 16.8], "seat": 0.85, "faces": [21.25, 15.55], "via": [[21.25, 17.5], [19.3, 17.5], [19.3, 15.6]] },
      { "pos": [10, 17.46], "seat": 0.75, "faces": [10, 16.5] },
      { "pos": [11.6, 17.46], "seat": 0.75, "faces": [11.6, 16.5] },
      { "pos": [13.2, 17.46], "seat": 0.75, "faces": [13.2, 16.5] }
    ],
