      { "model": "rug.glb", "position": [21.5, 2.5], "size": [4.6, 4.6, 0.01], "color": "#3E4C66" },
      { "model": "meeting_table.glb", "position": [21.6, 2.35], "size": [2.8, 1.9, 0.75] },
      { "model": "office_chair.glb", "positions": [[20.6, 0.85], [21.6, 0.85], [22.6, 0.85]], "rotationY": 0 },
      { "model": "office_chair.glb", "positions": [[20.6, 3.85], [21.6, 3.85], [22.6, 3.85]], "rotationY": 180 },
      { "model": "wall_screen.glb", "wall": "wall-back-right", "from": 20, "to": 23, "y": [1.2, 2.3] }
    ] },
    { "id": "break-area", "label": "Break area", "bounds": [18.5, 13, 24, 18], "glassWalls": [{ "from": [18.5, 13], "to": [24, 13] }, { "from": [24, 13], "to": [24, 18] }, { "from": [18.5, 18], "to": [24, 18] }, { "from": [18.5, 13], "to": [18.5, 14.9] }, { "from": [18.5, 16.3], "to": [18.5, 18] }], "door": { "from": [18.5, 14.9], "to": [18.5, 16.3] }, "items": [
      { "model": "rug.glb", "position": [21.3, 15.6], "size": [4.6, 4.2, 0.01], "color": "#D9A441" },
