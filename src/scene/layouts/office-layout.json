  "labels": [
    { "id": "task-board", "anchor": [0, 3.1, 4.8], "title": "Task board", "sub": "{active} active · {todo} todo · {review} review", "route": "/w/:id/tasks" },
    { "id": "orchestrator", "anchor": [2.8, 2.7, 13.8], "title": "{orchestrator.name}", "sub": "Orchestrator · {status}", "route": "/w/:id/orchestrator", "accent": "status.working" },
    { "id": "project-files", "anchor": [6.6, 2.0, 16.3], "title": "Project files", "sub": "{workspace.folderPath}", "route": "/w/:id/files" },
    { "id": "coffee", "anchor": [11.6, 1.4, 16.5], "title": "Coffee", "sub": "Fresh pot" },
    { "id": "meeting-room", "anchor": [21.5, 2.9, 2.5], "title": "Meeting room", "sub": "Free · next standup {time}" },
    { "id": "break-area", "anchor": [23.7, 0.1, 17.7], "title": "Break area", "sub": "Idle agents rest here" },
    { "id": "agent", "anchorFromStand": { "dy": 2.0 }, "title": "{agent.name}", "sub": "{agent.role}", "statusBubble": { "dy": 1.75, "working": "•••", "review": "!", "blocked": "!", "idle": "z" }, "onClick": "select-agent" }
